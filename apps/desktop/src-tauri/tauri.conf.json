{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamkeeper",
  "version": "0.1.0",
  "identifier": "dev.streamkeeper.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Streamkeeper",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": ["../../../docs/licenses/*"],
    "windows": {
      "nsis": { "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
